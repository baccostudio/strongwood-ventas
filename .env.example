# Copy to .env.local for development or .env for Docker Compose on the VPS.
# Never commit filled environment files or pass private keys as build arguments.

# Public build configuration. Rebuild the image after changing either value.
SITE_URL=https://www.strongwoodventas.com.ar
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Runtime-only Turnstile secret. Create a Managed widget for both hostnames.
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=www.strongwoodventas.com.ar,strongwoodventas.com.ar
# Development: use a separate widget allowing localhost and set hostnames to localhost.
# Missing/invalid Turnstile configuration blocks SMTP. No production bypass.

# VPS port checked against listeners and existing Docker port bindings.
# Recheck availability before deploying on another host.
# The published socket always binds to 127.0.0.1; Nginx terminates HTTPS.
HOST_PORT=3102

# Runtime-only Hostinger SMTP configuration for the home page contact form.
# Port 465 uses SMTP_SECURE=true; port 587 uses SMTP_SECURE=false (STARTTLS).
# Fill the mailbox password directly on the VPS; do not paste it into chat.
# Single-quote passwords in .env to preserve literal $ and # characters.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@strongwood.com.ar
SMTP_PASS=
# Optional: sender and recipient default to SMTP_USER.
SMTP_FROM=info@strongwood.com.ar
SMTP_TO=info@strongwood.com.ar

# Turnstile + honeypot + server validation + in-memory limits protect SMTP.
# Limits per process: 5 attempts/IP/10 minutes and 30 SMTP attempts/hour.
# Counters reset when the container restarts. Nginx must overwrite X-Real-IP
# with the actual client IP; never pass through a visitor-supplied X-Real-IP.
# /STRONGWOOD_COCINAS uses the existing public Google Apps Script integration.
